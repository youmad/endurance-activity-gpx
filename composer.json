{
    "name": "youmad/endurance-activity-gpx",
    "description": "GPX recorded tracks mapped to Endurance Activity import streams",
    "type": "library",
    "license": "MPL-2.0",
    "require": {
        "php": "^8.5",
        "youmad/endurance-gpx": "^0.1.0",
        "youmad/endurance-activity": "^0.1.4",
        "youmad/endurance-foundation": "^0.1.2",
        "youmad/endurance-activity-analysis": "^0.1.0"
    },
    "autoload": {
        "psr-4": {
            "Youmad\\Endurance\\ActivityGpx\\": "src/"
        }
    },
    "autoload-dev": {
