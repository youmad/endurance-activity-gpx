{
    "name": "endurance/activity-gpx",
    "description": "GPX recorded tracks mapped to Endurance Activity import streams",
    "type": "library",
    "license": "MPL-2.0",
    "require": {
        "php": "^8.5",
        "endurance/gpx": "^0.2.0",
        "endurance/activity": "^0.2.0",
        "endurance/foundation": "^0.2.0",
        "endurance/activity-analysis": "^0.2.0"
    },
    "autoload": {
        "psr-4": {
            "Endurance\\ActivityGpx\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Endurance\\ActivityGpx\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "scripts": {
        "test": "phpunit"
    }
}
